{
  "schemaVersion": 1,
  "id": "healthindicator",
  "version": "${version}",
  "name": "HealthIndicator",
  "description": "shows you a warning when your health goes under a certain amount",
  "authors": [
    "uku"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/healthindicator/icon.png",
  "environment": "client",
  "entrypoints": {
