      "net.uku3lig.healthindicator.UkulibHook"
    ]
  },
  "mixins": [
    "healthindicator.mixins.json",
    "healthindicator-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": ">=26.1",
    "fabricloader": ">=0.18",
    "ukulib": "^2.0.0"
  }
}
